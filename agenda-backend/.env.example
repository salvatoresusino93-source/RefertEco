# ─── Supabase ───────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=xxxx
SUPABASE_SERVICE_KEY=xxxx

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia-questa-stringa-con-qualcosa-di-lungo-e-casuale

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Orthanc ────────────────────────────────────────────────────────────────
ORTHANC_URL=http://localhost:8042
ORTHANC_WORKLIST_FOLDER=/path/to/orthanc/worklists
ORTHANC_AE_TITLE=ORTHANC

# ─── Ecografo Samsung Medison V5 ─────────────────────────────────────────────
ECOGRAFO_AE_TITLE=SAMSUNGV5
ECOGRAFO_MODALITY=US

# ─── Medico ─────────────────────────────────────────────────────────────────
MEDICO_NOME=Cognome^Nome

# ─── Email (Resend) — notifiche al medico, prenotazione online, ricevute ────
RESEND_API_KEY=re_xxxx
# Mittente. Con il dominio di test onboarding@resend.dev, Resend consegna
# SOLO all'indirizzo del proprietario dell'account. Per inviare ai pazienti
# (es. ricevuta di pagamento) serve un dominio verificato su Resend.
EMAIL_FROM=Studio Ecografico <noreply@studiosusino.it>

# ─── SMS (SMS Hosting) — promemoria, conferma prenotazione, recensioni ──────
SMSHOSTING_API_KEY=xxxx
SMSHOSTING_API_SECRET=xxxx
STUDIO_TELEFONO=
STUDIO_SITO=studiosusino.it

# ─── URL pubblico dell'app ────────────────────────────────────────────────
# APP_URL è riservata ai link SMS di conferma presenza paziente
# (conferma.studiosusino.it — vedi app.js, che reindirizza a studiosusino.it
# qualsiasi percorso su quel dominio diverso da /p/...). NON usarla per altro:
# se i link "Conferma"/"Rifiuta" nell'email al medico o i redirect di Stripe
# Checkout puntassero a quel dominio, verrebbero deviati sul sito vetrina e
# la prenotazione non si confermerebbe mai.
APP_URL=https://conferma.studiosusino.it
# URL pubblico usato invece da tutto il resto (link "Conferma"/"Rifiuta" nella
# email al medico, redirect di Stripe Checkout, pulsante "Prenota" su Google
# Business Profile). Se non impostata usa il dominio Railway di default.
PUBLIC_BASE_URL=https://referteco-production.up.railway.app

# ─── Pagamento online visita (Stripe) ────────────────────────────────────────
# Lascia vuoto STRIPE_SECRET_KEY per disattivare il pagamento online
# (la prenotazione funziona solo in modalità "paga in studio").
# Chiavi in Dashboard Stripe → Sviluppatori → Chiavi API (usa le chiavi "test" all'inizio).
STRIPE_SECRET_KEY=sk_test_xxxx
# Segreto di firma del webhook (Dashboard Stripe → Sviluppatori → Webhook → endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxxx
# Importo INTERO della visita in centesimi (8000 = 80,00 €)
IMPORTO_PAGAMENTO_CENT=8000
